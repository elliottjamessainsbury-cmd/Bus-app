# --- Local data store ---------------------------------------------------
# The SQLite event store is a local research artifact, never committed.
*.db
*.sqlite
*.sqlite3

# --- Secrets ------------------------------------------------------------
# TFL_APP_KEY is read from the environment; never commit a key or .env file.
.env
.env.*

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- Local imports / scratch -------------------------------------------
# Raw Google Form CSV exports are local data, not source — ignore them.
*.csv
# ...but allow small, committed CSV fixtures used by tests (the negation must
# come after the ignore rule above to take effect).
!tests/fixtures/*.csv
# ...and the manual-log template is source (a canonical column spec), not data.
!manual_log_template.csv
